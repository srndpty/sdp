root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown は行末スペースが意味を持つ場合があるため除去しない
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[Makefile]
indent_style = tab
